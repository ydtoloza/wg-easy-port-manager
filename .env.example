# Copia este archivo a .env y rellena los valores.
# NUNCA subas .env al repositorio.

# Versión estable recomendada. Usa main para el último commit validado o
# sha-<commit completo> para fijar una compilación concreta.
IMAGE_TAG=2.2.0

# IP pública o dominio del servidor
WG_HOST=TU_IP_PUBLICA

# Hash bcrypt de la contraseña del panel (NUNCA en texto plano).
# Genera el tuyo con:
#   docker run --rm ghcr.io/ydtoloza/wg-easy-port-manager:2.0.0 wgpw TU_PASSWORD
# En .env los símbolos $ se escriben sin escapar.
PASSWORD_HASH='$2a$12$MI_BCRYPT_HASH'

# Obligatorio: al menos 32 bytes aleatorios. Ejemplo de generación: openssl rand -hex 32
SESSION_SECRET=

# Actívalo sólo si el panel se publica exclusivamente mediante HTTPS.
# SESSION_COOKIE_SECURE=true

# IP del proxy inverso que puede proporcionar X-Forwarded-For.
# TRUSTED_PROXY_IP=127.0.0.1

# Opcional:
# WG_EASY_LANG=es
# WG_PORT=51820
# PORT=51821
# WG_DEVICE=eth0
# WG_DEFAULT_ADDRESS=10.8.0.x
# WG_DEFAULT_ADDRESS_V6=fd42:42:42::x
# WG_DEFAULT_DNS=1.1.1.1
# WG_ALLOWED_IPS=0.0.0.0/0, ::/0
# WG_MTU=1420                # 1420 para 1500 MTU, 1280 si hay PPPoE/VLAN; ahora se aplica al servidor wg0
# WG_PERSISTENT_KEEPALIVE=25
# --- Tuning para seeding qBittorrent (recomendado dejar default true) ---
# WG_NFT_MASQUERADE=true     # true: NAT masquerade via nft (atómico, más rápido). false: usa iptables
# WG_SEED_TUNING=true        # true: aplica sysctl fq/bbr e ip_forward en PostUp + txqueuelen 5000 en wg0
# En el host (una vez): sudo bash scripts/host-tune.sh --apply
# Ver preset qBittorrent en docs/qbittorrent-seed.md
# --- Dashboard de trafico estilo Plex (ANCHO DE BANDA / CPU / RAM + picos) ---
# UI_TRAFFIC_STATS=true      # muestra TX/RX por cliente y auto-muestra el panel lateral
#                            # (sin esto el panel queda oculto y el layout no cambia)
# UI_CHART_TYPE=2            # 0=off 1=linea 2=area 3=barras (sparklines por cliente)
# TRAFFIC_POLL_MS=1000       # muestreo del sampler (500-10000ms)
# TRAFFIC_SAMPLES=120        # ventana rolling, 120 = ~2min a 1s como Plex (30-600)
