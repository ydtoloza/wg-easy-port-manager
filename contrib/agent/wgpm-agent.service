[Unit]
Description=wg-easy port manager agent (webhook-driven torrent port sync)
Documentation=https://github.com/ydtoloza/wg-easy-port-manager/tree/main/contrib/agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Configuration is env-only. Keep the token out of this unit file (which is
# often world-readable) — put the Environment lines in /etc/wgpm-agent.env
# (chmod 600, root-owned) instead.
EnvironmentFile=/etc/wgpm-agent.env
# Adjust the path to where you placed agent.py (e.g. /opt/wgpm-agent/agent.py).
ExecStart=/usr/bin/python3 /opt/wgpm-agent/agent.py
User=wgpm-agent
Group=wgpm-agent
UMask=0077
Restart=always
RestartSec=5

# Hardening
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
StateDirectory=wgpm-agent
StateDirectoryMode=0700
# Point WGPM_STATE_FILE at /var/lib/wgpm-agent/state.json in the env file,
# since ProtectHome makes ~/.wgpm-agent.json unwritable.

[Install]
WantedBy=multi-user.target
