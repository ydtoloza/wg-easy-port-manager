# wg-easy peer API. HTTPS and an exact peer id are mandatory because the
# server webhook sink is shared by all peers.
WGPM_URL=https://vps.example.com
WGPM_TOKEN=wgpt_paste_your_token_here
WGPM_PEER_ID=client1
WGPM_WEBHOOK_SECRET=shared-with-the-server

WGPM_CLIENT=qbittorrent
WGPM_LISTEN=127.0.0.1:8080
WGPM_POLL_SECONDS=300
WGPM_WEBHOOK_TOLERANCE=120
WGPM_STATE_FILE=/var/lib/wgpm-agent/state.json

# Client endpoints require an explicit http:// or https:// scheme and may
# include a base path. Uncomment only the selected client's settings.
QBIT_URL=http://127.0.0.1:8081
QBIT_USER=admin
QBIT_PASS=secret

# TR_HOST=http://127.0.0.1:9091
# TR_USER=transmission
# TR_PASS=secret

# DELUGE_HOST=http://127.0.0.1:8112
# DELUGE_PASS=secret
